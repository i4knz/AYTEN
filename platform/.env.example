# Copy to .env.local for development. Never commit real secrets.

# Runtime connection — must use the non-owner role so row-level security applies.
DATABASE_URL=postgres://ayten_app:ayten_app_dev@localhost:5432/ayten
# Migrations only.
DATABASE_OWNER_URL=postgres://ayten_owner:ayten_owner_dev@localhost:5432/ayten

# Public URL of the merchant app (dashboard, auth pages).
APP_URL=http://localhost:3000
# Storefronts are served at <slug>.<STOREFRONT_ROOT_DOMAIN>. *.localhost resolves to 127.0.0.1 in modern browsers.
STOREFRONT_ROOT_DOMAIN=localhost:3000

# Email: "log" appends messages to OUTBOX_DIR/outbox.jsonl (dev/test); "smtp" sends via SMTP_URL.
EMAIL_TRANSPORT=log
OUTBOX_DIR=.data
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Ayten Commerce <no-reply@example.com>"

# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Multiplies all rate limits (default 1). Only for tests, or temporarily when many users share one IP.
# RATE_LIMIT_SCALE=1

# File storage for product images and logos. "local" keeps files on disk (single server only).
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads

# Online payments. Only "test" exists today: a simulated hosted payment page
# for development/staging (no real money). Leave empty to disable online payments.
PAYMENT_GATEWAY=
# Required when PAYMENT_GATEWAY=test in production builds.
PAYMENT_TEST_SECRET=
